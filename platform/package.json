{
  "name": "practicum-ai-skills",
  "version": "0.1.0",
  "private": true,
  "description": "AI skills learning platform for universities: public site, sample lesson, student and educator workspaces (pilot prototype).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "create-institution": "node --disable-warning=ExperimentalWarning scripts/create-institution.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "retention": "node --disable-warning=ExperimentalWarning scripts/retention.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "test:a11y": "node --disable-warning=ExperimentalWarning scripts/a11y-check.js",
    "docs:evidence": "node scripts/export-evidence.js",
    "export:prototype": "node --disable-warning=ExperimentalWarning scripts/export-prototype.js",
    "package": "node scripts/package-release.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2"
  }
}
